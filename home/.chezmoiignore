{{- /* Target paths that only make sense on some OSes. */ -}}
{{- if ne .chezmoi.os "darwin" }}
# macOS-only apps and paths
Library
.config/karabiner
.config/ghostty
.config/kitty
.config/rex
.config/tableplus
{{- end }}

{{- if ne .chezmoi.os "windows" }}
# Windows-only: PowerShell profile, AppData links, WezTerm (Ghostty's stand-in)
Documents
AppData
.config/wezterm
.config/autohotkey
.config/lazygit/windows.yml
{{- end }}

{{- if not (and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft")) }}
# WSL-only: space-free link to Windows Chrome for $BROWSER (see .zshrc)
.config/zsh/chrome
{{- end }}

{{- if eq .chezmoi.os "windows" }}
# zsh and Unix-only tools; WSL gets these instead (see docs/windows.md)
.zshrc
.config/zsh
.config/zellij
.config/herdr
# `wt` collides with Windows Terminal's launcher
.config/worktrunk
# The POSIX run scripts; PowerShell twins live next to them
bat-cache.sh
install-packages.sh
{{- end }}
