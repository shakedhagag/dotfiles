{{- if eq .chezmoi.os "windows" -}}
# Starts ~/.config/autohotkey/hyper.ahk (Caps Lock = Hyper, Office key
# blocked) now and at login. `run_after_`, not `run_onchange_`: it runs on
# every `chezmoi apply`, so a script that stopped (e.g. after the repo moved)
# comes back. Cheap: #SingleInstance Force just replaces a running copy.
$ErrorActionPreference = 'Stop'
$ahk = Join-Path $HOME 'scoop\apps\autohotkey\current\v2\AutoHotkey64.exe'
$script = Join-Path $HOME '.config\autohotkey\hyper.ahk'
if (-not (Test-Path $ahk)) { Write-Warning "autohotkey: $ahk missing (scoop install extras/autohotkey)"; exit 0 }

# The Office key (Hyper alone opening Microsoft 365) is blocked inside
# hyper.ahk; the old ms-officeapp registry trick has no effect on this build.

# ── Start at login ───────────────────────────────────────────────────────────
$lnk = Join-Path ([Environment]::GetFolderPath('Startup')) 'hyper.ahk.lnk'
$sh = New-Object -ComObject WScript.Shell
$s = $sh.CreateShortcut($lnk)
$s.TargetPath = $ahk
$s.Arguments = "`"$script`""
$s.WorkingDirectory = Split-Path $script
$s.Save()

# ── (Re)start now ────────────────────────────────────────────────────────────
# #SingleInstance Force replaces an already-running copy.
Start-Process -FilePath $ahk -ArgumentList "`"$script`""
Write-Host 'autohotkey: hyper.ahk running'
{{ end -}}
