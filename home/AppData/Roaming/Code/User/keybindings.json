// Windows port of the macOS VS Code keybindings:
//   home/private_Library/private_Application Support/private_Code/User/keybindings.json
// Keep the two files in step: same sections, same order, same `when` scopes.
// Translation rules used here:
//   - mac cmd -> ctrl; mac ctrl stays ctrl; alt stays alt.
//   - Hyper (ctrl+shift+alt+cmd, from Karabiner/Rex) -> ctrl+shift+alt. Windows
//     reserves ctrl+shift+alt+Win for the Office key, so the Win key is dropped.
//   - "-command" unbinds name the command's WINDOWS default key.
//   - On macOS the editor defaults live on cmd, so ctrl is free. On Windows the
//     ctrl+h/j/k/l pane keys (and a few others) shadow VS Code defaults in their
//     `when` scope; each such spot is marked "WINDOWS:" below.
[
	//
	// NAVIGATION
	//
	// WINDOWS: these shadow, inside their `when` scope (Vim Normal/Visual mode,
	// side bar, panels, lists, terminal): ctrl+h (Replace), ctrl+j (Toggle
	// Panel), ctrl+l (Expand Line Selection), and the whole ctrl+k chord family
	// (ctrl+k ctrl+s shortcuts, ctrl+k ctrl+c/u comment, ctrl+k ctrl+0/j fold,
	// ctrl+k z zen, ctrl+k ctrl+t theme, ctrl+k m language, ctrl+k s save all...).
	// Those still work in Vim Insert mode and in text inputs, and all are in the
	// command palette (ctrl+shift+p).
	{
		"key": "ctrl+h",
		"command": "workbench.action.navigateLeft",
		"when": "editorTextFocus && vim.active && vim.mode != 'Insert' && !inQuickOpen && !suggestWidgetVisible && !terminalFocus"
	},
	{
		"key": "ctrl+l",
		"command": "workbench.action.navigateRight",
		"when": "editorTextFocus && vim.active && vim.mode != 'Insert' && !inQuickOpen && !suggestWidgetVisible && !terminalFocus"
	},
	{
		"key": "ctrl+j",
		"command": "workbench.action.navigateDown",
		"when": "editorTextFocus && vim.active && vim.mode != 'Insert' && !inQuickOpen && !suggestWidgetVisible && !terminalFocus"
	},
	{
		"key": "ctrl+k",
		"command": "workbench.action.navigateUp",
		"when": "editorTextFocus && vim.active && vim.mode != 'Insert' && !inQuickOpen && !suggestWidgetVisible && !terminalFocus"
	},
	{
		"key": "ctrl+q",
		"command": "workbench.action.closeAllEditors",
		"when": "inEditorsPicker"
	},
	{
		"key": "space m",
		"command": "workbench.action.toggleMaximizeEditorGroup",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space =",
		"command": "workbench.action.evenEditorWidths",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "ctrl+h",
		"command": "workbench.action.navigateLeft",
		"when": "!editorTextFocus && !terminalFocus && !inQuickOpen && !suggestWidgetVisible && (sideBarFocus || panelFocus || auxiliaryBarFocus || filesExplorerFocus || listFocus || chatInputHasFocus || !inputFocus)"
	},
	{
		"key": "ctrl+l",
		"command": "workbench.action.navigateRight",
		"when": "!editorTextFocus && !terminalFocus && !inQuickOpen && !suggestWidgetVisible && (sideBarFocus || panelFocus || auxiliaryBarFocus || filesExplorerFocus || listFocus || chatInputHasFocus || !inputFocus)"
	},
	{
		"key": "ctrl+j",
		"command": "workbench.action.navigateDown",
		"when": "!editorTextFocus && !terminalFocus && !inQuickOpen && !suggestWidgetVisible && (sideBarFocus || panelFocus || auxiliaryBarFocus || filesExplorerFocus || listFocus || chatInputHasFocus || !inputFocus)"
	},
	{
		"key": "ctrl+k",
		"command": "workbench.action.navigateUp",
		"when": "!editorTextFocus && !terminalFocus && !inQuickOpen && !suggestWidgetVisible && (sideBarFocus || panelFocus || auxiliaryBarFocus || filesExplorerFocus || listFocus || chatInputHasFocus || !inputFocus)"
	},
	// Focus inside a webview (Claude Code) sets no focus context, and navigate* can't locate it.
	{
		"key": "ctrl+h",
		"command": "workbench.action.focusActiveEditorGroup",
		"when": "!editorTextFocus && !inputFocus && !terminalFocus && !inQuickOpen && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !listFocus"
	},
	{
		"key": "s h",
		"command": "workbench.action.moveEditorToLeftGroup",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},
	{
		"key": "s l",
		"command": "workbench.action.moveEditorToRightGroup",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},
	{
		"key": "space n t",
		"command": "editor.emmet.action.matchTag",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space n b",
		"command": "editor.action.jumpToBracket",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "s v",
		"command": "workbench.action.splitEditor",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},
	{
		"key": "s s",
		"command": "workbench.action.splitEditorDown",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},

	//
	// CODING
	//
	// No `g …` chords here: a chord makes VS Code swallow every other g-key (`g d`, `g g`)
	// before VSCodeVim sees it, and keys are case-insensitive ("g D" is `g d`).
	// The g-mappings live in vim.normalModeKeyBindingsNonRecursive in settings.json.
	{
		"key": "shift-k",
		"command": "editor.action.moveLinesUpAction",
		"when": "editorTextFocus && vim.active && vim.mode == 'VisualLine'"
	},
	{
		"key": "shift-j",
		"command": "editor.action.moveLinesDownAction",
		"when": "editorTextFocus && vim.active && vim.mode == 'VisualLine'"
	},
	{
		"key": "shift-k",
		"command": "editor.action.showHover",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},
	{
		"key": "space g s",
		"command": "workbench.action.gotoSymbol",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space b d",
		"command": "workbench.action.closeActiveEditor",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space b o",
		"command": "workbench.action.closeOtherEditors",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	// nvim `<Leader>bm`: close every editor whose file has no git changes.
	{
		"key": "space b m",
		"command": "git.closeAllUnmodifiedEditors",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	// Replace the whole layout with the changed files: close every editor and split,
	// then open each unstaged/untracked file (staged-only and deleted files are skipped).
	{
		"key": "space b shift+m",
		"command": "runCommands",
		"args": {
			"commands": [
				"workbench.action.closeAllGroups",
				"git.openAllChanges"
			]
		},
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space space",
		"command": "workbench.action.showAllEditors",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space f b",
		"command": "workbench.action.showAllEditors",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space s f",
		"command": "workbench.action.quickOpen",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space s g",
		"command": "workbench.action.findInFiles",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space g g",
		"command": "workbench.action.terminal.newWithProfile",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus",
		// Runs lazygit as the terminal's process: no zsh startup, and the tab closes on quit
		"args": { "profileName": "lazygit", "location": "editor" }
	},
	{
		"key": "space g d",
		"command": "git.openChange",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space g l",
		"command": "workbench.scm.history.focus",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space g r",
		"command": "git.revertSelectedRanges",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space g b",
		"command": "git.blame.toggleEditorDecoration",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space m f",
		"command": "workbench.view.scm",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space g w",
		"command": "git.createWorktree",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space g u",
		"command": "git.viewChanges",
		// With no editor open, focus is rarely on the empty editor area (sidebar, nothing), so also fire then.
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	// WINDOWS: shadows ctrl+n (New Untitled File) in Vim Normal/Visual mode; use space b n.
	{
		"key": "ctrl-n",
		"command": "editor.action.nextMatchFindAction",
		"when": "editorTextFocus && vim.active && (vim.mode == 'Normal' || vim.mode == 'Visual')"
	},

	//
	// SUGGESTIONS AND AUTOCOMPLETION
	//
	{
		"key": "ctrl+j",
		"command": "selectNextSuggestion",
		"when": "suggestWidgetVisible"
	},
	{
		"key": "ctrl+k",
		"command": "selectPrevSuggestion",
		"when": "suggestWidgetVisible"
	},
	{
		"key": "ctrl+j",
		"command": "workbench.action.quickOpenSelectNext",
		"when": "inQuickOpen"
	},
	{
		"key": "ctrl+k",
		"command": "workbench.action.quickOpenSelectPrevious",
		"when": "inQuickOpen"
	},
	// WINDOWS: ctrl+y is Redo; only shadowed while the suggest widget is open.
	{
		"key": "ctrl+y",
		"command": "acceptSelectedSuggestion",
		"when": "suggestWidgetVisible"
	},

	//
	// BUFFER/TAB NAVIGATION
	//
	{
		"key": "] b",
		"command": "workbench.action.nextEditorInGroup",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},
	{
		"key": "[ b",
		"command": "workbench.action.previousEditorInGroup",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},
	{
		"key": "[ t",
		"command": "workbench.action.moveEditorToPreviousGroup",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},
	{
		"key": "] t",
		"command": "workbench.action.moveEditorToNextGroup",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},
	{
		"key": "[ d",
		"command": "editor.action.marker.prevInFiles",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},
	{
		"key": "] d",
		"command": "editor.action.marker.nextInFiles",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},
	// mac: Hyper+- (ctrl+shift+alt+cmd+-)
	{
		"key": "ctrl+shift+alt+-",
		"command": "workbench.action.toggleEditorWidths",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
	},

	//
	// FILE EXPLORER
	//
	{
		"key": "r",
		"command": "renameFile",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
	},
	{
		"key": "c",
		"command": "filesExplorer.copy",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
	},
	{
		"key": "p",
		"command": "filesExplorer.paste",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
	},
	{
		"key": "x",
		"command": "filesExplorer.cut",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
	},
	{
		"key": "d",
		"command": "deleteFile",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
	},
	{
		"key": "a",
		"command": "explorer.newFile",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
	},
	{
		"key": "s",
		"command": "explorer.openToSide",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
	},
	{
		"key": "shift-s",
		"command": "runCommands",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
		"args": {
			"commands": [
				"workbench.action.splitEditorDown",
				"explorer.openAndPassFocus",
				"workbench.action.closeOtherEditors"
			]
		}
	},
	{
		"key": "enter",
		"command": "explorer.openAndPassFocus",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceIsFolder && !inputFocus"
	},
	{
		"key": "enter",
		"command": "list.toggleExpand",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && explorerResourceIsFolder && !inputFocus"
	},

	//
	// FILE EXPLORER NAVIGATION
	//
	{
		"key": "h",
		"command": "list.collapse",
		"when": "listFocus && !inputFocus"
	},
	{
		"key": "l",
		"command": "list.expand",
		"when": "listFocus && !inputFocus"
	},
	// On a file, Snacks' `l` opens it; list.expand does nothing there.
	{
		"key": "l",
		"command": "explorer.openAndPassFocus",
		"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus"
	},
	{
		"key": "k",
		"command": "list.focusUp",
		"when": "listFocus && !inputFocus"
	},
	{
		"key": "j",
		"command": "list.focusDown",
		"when": "listFocus && !inputFocus"
	},

	//
	// DEBUG
	//
	{
		"key": "space d a",
		"command": "workbench.action.debug.selectandstart",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' && debuggersAvailable"
	},
	{
		"key": "space d t",
		"command": "workbench.action.debug.stop",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' && inDebugMode && !focusedSessionIsAttached"
	},
	{
		"key": "space d o",
		"command": "workbench.action.debug.stepOver",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' && inDebugMode && debugState == 'stopped'"
	},
	{
		"key": "space d i",
		"command": "workbench.action.debug.stepInto",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' && inDebugMode && debugState == 'stopped'"
	},
	{
		"key": "space d b",
		"command": "editor.debug.action.toggleBreakpoint",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space d e",
		"command": "editor.debug.action.showDebugHover",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' && inDebugMode && debugState == 'stopped'"
	},
	{
		"key": "space d c",
		"command": "workbench.action.debug.continue",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' && inDebugMode && debugState == 'stopped'"
	},

	//
	// COMPOSER/AI
	//
	{
		"key": "shift+h",
		"command": "workbench.action.previousEditor",
		"when": "vim.active && vim.mode != 'Insert' && editorFocus"
	},
	{
		"key": "shift+l",
		"command": "workbench.action.nextEditor",
		"when": "vim.active && vim.mode != 'Insert' && editorFocus"
	},

	//
	// TERMINAL
	//
	{
		"key": "ctrl+;",
		"command": "workbench.action.terminal.focus"
	},
	{
		"key": "ctrl+;",
		"command": "workbench.action.focusActiveEditorGroup",
		"when": "terminalFocus"
	},
	// Split the terminal with Rex's split chord (Hyper+d / ctrl+alt+d), not cmd+\,
	// which 1Password takes globally.
	// WINDOWS: there is no Rex; ctrl+alt+d stays for muscle memory, Hyper+d becomes
	// ctrl+shift+alt+d, and the unbind targets the Windows default (ctrl+shift+5).
	{
		"key": "ctrl+alt+d",
		"command": "workbench.action.terminal.split",
		"when": "terminalFocus"
	},
	{
		"key": "ctrl+shift+alt+d",
		"command": "workbench.action.terminal.split",
		"when": "terminalFocus"
	},
	{
		"key": "ctrl+shift+5",
		"command": "-workbench.action.terminal.split"
	},
	// Terminal: Ctrl+h/j/k/l leave it like any other pane (nvim terminal mode does the same).
	// The commands are in terminal.integrated.commandsToSkipShell, or the shell would get them.
	{
		"key": "ctrl+j",
		"command": "workbench.action.navigateDown",
		"when": "terminalFocus"
	},
	{
		"key": "ctrl+h",
		"command": "workbench.action.navigateLeft",
		"when": "terminalFocus"
	},
	{
		"key": "ctrl+k",
		"command": "workbench.action.navigateUp",
		"when": "terminalFocus"
	},
	{
		"key": "ctrl+l",
		"command": "workbench.action.navigateRight",
		"when": "terminalFocus"
	},
	// Inside a split terminal, ctrl+h/l move between the splits instead (later
	// entries win). VS Code has no "leftmost split" key, so leave a split
	// terminal with ctrl+k (up to the editor) or ctrl+j.
	// terminalSplitPaneActive describes the panel's active terminal even when focus is
	// in a terminal editor (Claude Code with claudeCode.useTerminal), and these commands
	// jump to the panel, so exclude terminal editors.
	{
		"key": "ctrl+h",
		"command": "workbench.action.terminal.focusPreviousPane",
		"when": "terminalFocus && terminalSplitPaneActive && !terminalEditorFocus"
	},
	{
		"key": "ctrl+l",
		"command": "workbench.action.terminal.focusNextPane",
		"when": "terminalFocus && terminalSplitPaneActive && !terminalEditorFocus"
	},
	// mac: cmd+0. Replaces ctrl+0 (Focus Side Bar), as cmd+0 does on macOS.
	{
		"key": "ctrl+0",
		"command": "multiCommand.toggleMaximizedPanelAndFocusTerminal"
	},

	//
	// NAVIGATION HISTORY
	//
	// WINDOWS: shadows ctrl+o (Open File...) and ctrl+i (inline chat / trigger
	// suggest) everywhere except the terminal; on macOS those live on cmd+o/cmd+i.
	{
		"key": "ctrl+o",
		"command": "workbench.action.navigateBack",
		"when": "!terminalFocus"
	},
	{
		"key": "ctrl+i",
		"command": "workbench.action.navigateForward",
		"when": "!terminalFocus"
	},

	//
	// BOOKMARKS
	//
	{
		"key": "space h",
		"command": "bookmarks.toggle",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},
	{
		"key": "space b b",
		"command": "bookmarks.list",
		"when": "editorTextFocus && vim.active && vim.mode == 'Normal' || activeEditorGroupEmpty && editorAreaFocus && !inputFocus || !editorIsOpen && !inputFocus && !terminalFocus"
	},

	//
	// VIM ARROW KEY DISABLES
	//
	{
		"key": "up",
		"command": "-extension.vim_up",
		"when": "editorTextFocus && vim.active && !inDebugRepl && !parameterHintsVisible && !suggestWidgetVisible"
	},
	{
		"key": "down",
		"command": "-extension.vim_down",
		"when": "editorTextFocus && vim.active && !inDebugRepl && !parameterHintsVisible && !suggestWidgetVisible"
	},
	{
		"key": "right",
		"command": "-extension.vim_right",
		"when": "editorTextFocus && vim.active && !inDebugRepl"
	},
	{
		"key": "left",
		"command": "-extension.vim_left",
		"when": "editorTextFocus && vim.active && !inDebugRepl"
	},
	{
		"key": "escape",
		"command": "extension.vim_escape",
		"when": "editorTextFocus && vim.active && !inDebugRepl && !suggestWidgetVisible"
	},
	{
		"key": "escape",
		"command": "-extension.vim_escape",
		"when": "editorTextFocus && vim.active && !inDebugRepl"
	},
	{
		"key": "shift+tab",
		"command": "-extension.vim_shift+tab",
		"when": "editorTextFocus && vim.active && !inDebugRepl && vim.mode != 'Insert'"
	},
	{
		"key": "tab",
		"command": "-extension.vim_tab",
		"when": "editorTextFocus && vim.active && !inDebugRepl && vim.mode != 'Insert'"
